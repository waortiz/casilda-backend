@echo off

REM Java 21 (ajusta según tu instalación)
set "JAVA_HOME=C:\Program Files\Java\jdk-21"

REM Opciones JVM
set "JAVA_OPTS=-Xms512m -Xmx1024m -Dfile.encoding=UTF-8"

REM Variables Spring Boot
set "SPRING_PROFILES_ACTIVE=prod"
set "SERVER_PORT=8080"
set "SERVER_SERVLET_CONTEXT_PATH=/api/v1"

set "SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/casilda"
set "SPRING_DATASOURCE_USERNAME=postgres"
set "SPRING_DATASOURCE_PASSWORD=CAMBIAR_ESTA_CLAVE"

set "SPRING_JPA_HIBERNATE_DDL_AUTO=update"
set "SPRING_JPA_SHOW_SQL=false"

set "JWT_SECRET=CAMBIAR_EN_PRODUCCION"
set "JWT_EXPIRATION=86400000"

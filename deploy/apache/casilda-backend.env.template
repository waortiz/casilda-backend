# Variables de entorno para Spring Boot (producción)
# Copiar a /etc/casilda-backend/casilda-backend.env (el instalador lo hace por ti)

JAVA_OPTS="-Xms512m -Xmx1024m -Dspring.profiles.active=prod"

SPRING_DATASOURCE_URL="jdbc:postgresql://localhost:5432/casilda"
SPRING_DATASOURCE_USERNAME="postgres"
SPRING_DATASOURCE_PASSWORD="cambiar-esta-clave"

SPRING_JPA_HIBERNATE_DDL_AUTO="update"
SPRING_JPA_SHOW_SQL="false"

SERVER_PORT="8080"
SERVER_SERVLET_CONTEXT_PATH="/api/v1"

JWT_SECRET="CAMBIAR_EN_PRODUCCION"
JWT_EXPIRATION="86400000"
